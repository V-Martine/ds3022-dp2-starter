# Copy this file to .env (it is git-ignored) and set YOUR computing ID.
UVA_ID=mst3k

# Point boto3 at the local SQS emulator instead of AWS.
# Remove this line and the same boto3 code would talk to real AWS SQS unchanged.
# 127.0.0.1 (not 'localhost') avoids a slow IPv6 lookup on Windows.
AWS_ENDPOINT_URL_SQS=http://127.0.0.1:9324
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Scatter API (kit/scatter_api.py)
SCATTER_PORT=8000
# 1 = short delays (5-60 s) for development; 0 = real assignment delays (30-900 s)
DP2_FAST=1

# DuckDB file shared by your flow and dbt (relative to the repo root)
DP2_DUCKDB=dp2.duckdb

# Lesson 11 chaos round: 1 = also send duplicate and malformed messages
DP2_CHAOS=0
